<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>About - Travlr Getaways</title>
    <link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header}}
            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">
                            <h1>About</h1>
                            <h2>{{heading}}</h2>
                            {{#each paragraphs}}
                            <p>{{{this}}}</p>
                            {{/each}}
                            <hr>
                            <div class="ads">
                                <h2>Our Crews</h2>
                                <p>{{crews}}</p>
                                <h2>Amenities</h2>
                                <p>{{amenities}}</p>
                            </div>
                            <h2>Be Part of Our Community</h2>
                            <p>{{{community}}}</p>
                            <h2>Template Details</h2>
                            <p>{{{templateDetails}}}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{> footer}}
    </div>
</body>
</html>