<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical">

    <!-- ITEM NAME -->
    <TextView
        android:id="@+id/invItemName"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/itemName"
        android:textSize="15sp"
        android:textColor="#1A1A1A" />

    <!-- Quantity +/- -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:gravity="center" >

        <Button
            android:id="@+id/buttonReduceInventory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="#E0E0E0"
            android:contentDescription="@string/decreaseButtonDescription"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/dashSymbol"
            android:textColor="#1A1A1A"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textViewQuantity"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="@string/defaultQuantity"
            android:textSize="15sp"
            android:textColor="#1A1A1A"
            android:gravity="center" />

        <Button
            android:id="@+id/buttonIncreaseInventory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/addSymbol"
            android:textSize="15sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#E0E0E0"
            android:textColor="#1A1A1A"
            android:contentDescription="@string/addButtonDescription" />

    </LinearLayout>

    <!-- DELETE BUTTON -->
    <Button
        android:id="@+id/buttonDelete"
        android:layout_width="92dp"
        android:layout_height="48dp"
        android:text="@string/delete"
        android:textSize="12sp"
        android:backgroundTint="#C62828"
        android:textColor="#FFFFFF"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:contentDescription="@string/deleteButtonDescription" />

</LinearLayout>